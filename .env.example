# Copy to .env and adjust. Everything here is optional - the defaults are shown.
# This file is NOT where flatnotes credentials live; those are mounted from
# ./creds/<server-id>.env (see config/servers.yaml).

# Which instances this replica may serve: all | public | internal
MCP_EXPOSURE=all

# Whether the destructive `delete_note` tool is registered at all.
MCP_ALLOW_DELETE=true

# Host interface / published port for the MCP endpoint (path is /mcp).
MCP_BIND=127.0.0.1
MCP_PUBLISHED_PORT=8800

# DEBUG | INFO | WARNING | ERROR
MCP_LOG_LEVEL=INFO

# Name of the docker network shared with the main flatnotes instance.
FLATNOTES_NETWORK=flatnotes_default
